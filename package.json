{
  "name": "claude-hub",
  "private": true,
  "version": "0.5.2",
  "description": "Claude Hub — ilha dinâmica no macOS + PWA no iPhone para acompanhar e aprovar sessões do Claude Code",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --filter \"!@claude-hub/e2e\" run test",
    "test:e2e": "pnpm --filter @claude-hub/e2e run test",
    "dev:api": "pnpm --filter @claude-hub/api run dev",
    "dev:web": "pnpm --filter @claude-hub/web run dev",
    "start": "node services/api/dist/main.js",
    "hub": "node packages/claude-bridge/dist/cli.js",
    "bundle:runtime": "node scripts/bundle-runtime.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0",
    "esbuild": "^0.28.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "license": "MIT"
}
